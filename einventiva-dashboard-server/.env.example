# Server configuration
API_TOKEN=your-secret-token-here
PORT=3847
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Max runtime for dashboard scripts (ms). Updates, prunes and audits
# routinely take minutes; on timeout the local ssh is killed but the
# remote command keeps running.
SCRIPT_TIMEOUT_MS=600000

# AI analysis module (optional). AI_PROVIDER: 'openai' for any
# OpenAI-compatible endpoint (LiteLLM, OpenAI, xAI/Grok, Ollama, ...)
# or 'anthropic' for the native Claude API. Leave unset to disable.
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:4000/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_MAX_TOKENS=2500
# AI_KEEP_ANALYSES=100

# Metrics retention (days). History is the CPU/mem/disk time series;
# detail is the per-process/per-container breakdown, which grows ~35x faster.
PRUNE_KEEP_DAYS=30
DETAIL_KEEP_DAYS=3
# Hourly rollups power long-range trends and disk projections (tiny: ~26k rows/server/year)
ROLLUP_KEEP_DAYS=365

# Open a disk-eta alert when a disk is projected full within this many days
DISK_ETA_ALERT_DAYS=14

# Open an ssl alert when a certificate expires within this many days
# (requires passwordless sudo on the servers to read certbot config)
SSL_ALERT_DAYS=14

# PostgreSQL sampling: interval (minutes), retention (days), and the
# connection saturation percentage that opens a pg-connections alert
PG_SAMPLE_INTERVAL_MIN=5
PG_KEEP_DAYS=90
PG_CONN_ALERT_PCT=80
# Alert when a standby's replication lag exceeds this many MB (critical at 4x)
PG_REPL_LAG_ALERT_MB=100
# Explicit container->role mapping when auto-detection can't guess the
# superuser (roles are probed: POSTGRES_USER, postgres, name-derived)
# PG_USER_OVERRIDES={"pg-replica-foo":"foo_legacy_user"}

# Alert hysteresis: consecutive 15s samples over threshold to open an
# alert, and clean samples to resolve it (defaults: 2 = 30s / 4 = 1min)
ALERT_SAMPLES_TO_OPEN=2
ALERT_SAMPLES_TO_RESOLVE=4

# Optional webhook: receives POST { event: "opened"|"resolved", alert, sentAt }
# on every alert transition (Slack/Telegram bridge, n8n, etc.)
# ALERT_WEBHOOK_URL=https://example.com/webhook

